# AnnaSetu — Environment Configuration Template
# Copy this file to .env and fill in your keys when connecting external cloud services.

# Application
VITE_APP_NAME=AnnaSetu
VITE_APP_ENV=development

# -------------------------------------------------------------
# Optional External API Keys (Leave blank to use built-in mocks)
# -------------------------------------------------------------

# Mapping & Route Optimization (e.g., Mapbox / Google Maps Platform)
VITE_MAPBOX_ACCESS_TOKEN=
VITE_GOOGLE_MAPS_API_KEY=

# SMS & WhatsApp Notifications for NGO Handover OTPs (e.g., Twilio / Gupshup)
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_PHONE_NUMBER=

# Cloud Object Storage for Proof of Delivery Photos & Batch Labels (e.g., Cloudinary / AWS S3)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_API_KEY=
VITE_AWS_S3_BUCKET_NAME=
VITE_AWS_S3_REGION=

# IoT Cold Chain Sensor Gateway (MQTT / Webhook Endpoint)
VITE_IOT_MQTT_BROKER_URL=
VITE_IOT_API_SECRET=

# -------------------------------------------------------------
# AI Vision Scanner — Food Safety Analysis
# -------------------------------------------------------------
# Google Gemini Vision API (used by the AI Vision Quality Scanner)
# Get your key at: https://aistudio.google.com/app/apikey
# Without this key, a conservative safety-biased canvas fallback is used.
VITE_GEMINI_API_KEY=
